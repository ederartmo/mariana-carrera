# Template only. Copy to .env.local and fill locally; never commit credentials.
# Supabase: verify project ref uycwzhlcnfijjyzkgkem before using credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: TEST keys only locally. Verify the account before any payment integration.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional existing price IDs. If supplied, use prices from the same TEST account.
# Checkout falls back to inline prices when these are empty.
STRIPE_CASCANUECES_PREVENTA_PRICE_ID=
STRIPE_CASCANUECES_GENERAL_PRICE_ID=
STRIPE_CASCANUECES_LAST_MINUTE_PRICE_ID=

# Authorization and protection: use independent random secrets >=32 characters.
ADMIN_EMAILS=
RATE_LIMIT_SECRET=
CHECKOUT_SUMMARY_SECRET=

# Email. Sender overrides are optional; existing defaults remain in code.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_ADMIN_EMAIL=

# Meta/CAPI: optional for local architecture and unit tests.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=
META_TEST_EVENT_CODE=

# Runtime/build variables: normally provided by Vercel/GitHub.
# Leave empty locally unless deliberately testing those environments.
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=
GITHUB_SHA=
