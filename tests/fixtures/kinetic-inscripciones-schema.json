    },
    {
      "definition": "CREATE INDEX inscripciones_buyer_email_idx ON public.inscripciones USING btree (lower(TRIM(BOTH FROM buyer_email)))",
      "name": "inscripciones_buyer_email_idx"
    },
    {
      "definition": "CREATE INDEX inscripciones_event_distance_idx ON public.inscripciones USING btree (event_slug, distance)",
      "name": "inscripciones_event_distance_idx"
    },
    {
      "definition": "CREATE UNIQUE INDEX inscripciones_unique_event_bib_paid_idx ON public.inscripciones USING btree (event_slug, bib_number) WHERE ((payment_status = 'paid'::text) AND (event_slug IS NOT NULL) AND (bib_number IS NOT NULL) AND (bib_number ~ '^[0-9]+$'::text))",
      "name": "inscripciones_unique_event_bib_paid_idx"
    },
    {
      "definition": "CREATE UNIQUE INDEX inscripciones_active_event_bib_unique ON public.inscripciones USING btree (event_slug, bib_number) WHERE ((registration_status = 'active'::text) AND (bib_number IS NOT NULL))",
      "name": "inscripciones_active_event_bib_unique"
    }
  ]
