  "constraints": [
    {
      "definition": "CHECK (((cancellation_type IS NULL) OR (cancellation_type = ANY (ARRAY['duplicate'::text, 'refunded'::text, 'participation_cancelled'::text]))))",
      "name": "inscripciones_cancellation_type_check"
    },
    {
      "definition": "CHECK (((distance IS NULL) OR ((event_slug = 'axolote-night-run'::text) AND (distance = '5K'::text)) OR ((event_slug = 'cascanueces-run'::text) AND (distance = ANY (ARRAY['5K'::text, '10K'::text])))))",
      "name": "inscripciones_distance_chk"
    },
    {
      "definition": "PRIMARY KEY (id, email)",
      "name": "inscripciones_pkey"
    },
    {
      "definition": "CHECK ((registration_status = ANY (ARRAY['active'::text, 'cancelled'::text, 'archived'::text])))",
      "name": "inscripciones_registration_status_check"
    },
    {
      "definition": "CHECK (((shirt_size IS NULL) OR (shirt_size = ANY (ARRAY['XS'::text, 'S'::text, 'M'::text, 'L'::text, 'XL'::text, 'XXL'::text, 'XXXL'::text]))))",
      "name": "inscripciones_shirt_size_check"
    },
    {
      "definition": "UNIQUE (stripe_session_id)",
      "name": "inscripciones_stripe_session_id_key"
    },
    {
      "definition": "CHECK (((ticket_count IS NULL) OR (ticket_count >= 1)))",
      "name": "inscripciones_ticket_count_positive_chk"
    },
    {
      "definition": "CHECK (((ticket_index IS NULL) OR (ticket_index >= 1)))",
      "name": "inscripciones_ticket_index_positive_chk"
    }
  ],
  "indexes": [
    {
      "definition": "CREATE UNIQUE INDEX inscripciones_order_ticket_unique_idx ON public.inscripciones USING btree (order_session_id, ticket_index) WHERE ((order_session_id IS NOT NULL) AND (ticket_index IS NOT NULL))",
      "name": "inscripciones_order_ticket_unique_idx"
    },
    {
      "definition": "CREATE UNIQUE INDEX inscripciones_stripe_session_id_key ON public.inscripciones USING btree (stripe_session_id)",
      "name": "inscripciones_stripe_session_id_key"
    },
    {
      "definition": "CREATE UNIQUE INDEX inscripciones_pkey ON public.inscripciones USING btree (id, email)",
